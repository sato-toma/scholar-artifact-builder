{
  "name": "scholar-artifact-builder",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible builder for scholarly artifacts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "biome lint .",
    "start": "node dist/cli.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "bin": {
    "sab": "dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
